rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.email in [
            'yusufsaikincil@gmail.com',
            'admin@paxmedya.com.tr'
          ] ||
          request.auth.uid in [
            'm4zO1iCFPMWMqsn6QwtUkX5hL0y2'
          ] ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        );
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.email in [
            'yusufsaikincil@gmail.com',
            'admin@paxmedya.com.tr'
          ] ||
          request.auth.uid in [
            'm4zO1iCFPMWMqsn6QwtUkX5hL0y2'
          ] ||
          (
            exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) &&
            get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data.role == 'super_admin'
          )
        );
    }

    function myOrg() {
      return get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.org;
    }

    match /customers/{uid} {
      function validProfile() {
        return request.resource.data.keys().hasOnly(
                 ['org', 'contact', 'phone', 'email', 'ownerUid', 'createdAt']
               ) &&
               request.resource.data.ownerUid == uid &&
               request.resource.data.org is string &&
               request.resource.data.org.size() > 0;
      }

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid && validProfile());
      allow delete: if false;
    }

    match /requests/{id} {
      function validNewRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'code', 'title', 'description', 'note', 'org', 'ownerUid',
                 'status', 'assignee', 'feedback', 'createdAt', 'updatedAt',
                 'history'
               ]) &&
               d.ownerUid == request.auth.uid &&
               d.org == myOrg() &&
               d.status == 'Yeni' &&
               d.assignee == '—' &&
               d.feedback == '' &&
               d.code is string && d.code.matches('#PAX-[0-9]+') &&
               d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
               d.description is string && d.description.size() <= 5000 &&
               d.note is string && d.note.size() <= 2000 &&
               d.history.size() == 1;
      }

      function immutableFields() {
        return request.resource.data.code == resource.data.code &&
               request.resource.data.ownerUid == resource.data.ownerUid &&
               request.resource.data.org == resource.data.org &&
               request.resource.data.createdAt == resource.data.createdAt &&
               request.resource.data.history == resource.data.history;
      }

      function adminUpdateFieldsOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignee', 'feedback', 'updatedAt', 'deleted', 'deletedAt'
        ]);
      }

      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin() && immutableFields() && adminUpdateFieldsOnly();
      allow delete: if false;

      match /history/{entryId} {
        allow read: if isAdmin() ||
          (isSignedIn() &&
           get(/databases/$(database)/documents/requests/$(id)).data.ownerUid
             == request.auth.uid);
        allow create: if isAdmin() &&
          request.resource.data.keys().hasOnly(['event', 'by', 'date', 'at']) &&
          request.resource.data.event is string &&
          request.resource.data.event.size() <= 300;
        allow update, delete: if false;
      }
    }

    match /staff/{id} {
      allow read: if isAdmin();
      allow create, update: if isSuperAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100;
      allow delete: if isSuperAdmin();
    }

    match /admins/{email} {
      function validAdmin() {
        return request.resource.data.keys().hasOnly(
                 ['email', 'role', 'createdAt', 'updatedAt']
               ) &&
               request.resource.data.email == email &&
               request.resource.data.role in ['super_admin', 'admin'];
      }

      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.token.email == email);
      allow create, update: if isSuperAdmin() && validAdmin();
      allow delete: if isSuperAdmin() && request.auth.token.email != email;
    }

    match /settings/notifications {
      allow read: if isAdmin();
      allow create, update: if isSuperAdmin() &&
        request.resource.data.keys().hasOnly(['recipients', 'rules', 'updatedAt']) &&
        request.resource.data.recipients is list &&
        request.resource.data.recipients.size() <= 25 &&
        (!request.resource.data.keys().hasAny(['rules']) ||
          (request.resource.data.rules is list &&
           request.resource.data.rules.size() <= 100));
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /requestSubmissions/{id} {
      allow read, create, update, delete: if false;
    }

    match /rateLimits/{id} {
      allow read, create, update, delete: if false;
    }
  }
}
