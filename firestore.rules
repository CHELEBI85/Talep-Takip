rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Admin e-postaları — .env.local'deki NEXT_PUBLIC_ADMIN_EMAILS ile eşleşmeli
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email in [
          'yusufsaikincil@gmail.com',
          'admin@paxmedya.com.tr'
        ];
    }

    // Talebi oluşturanın kayıtlı kurum adı. Kurum adı istemciye (displayName)
    // değil, yalnızca customers/{uid} belgesine güvenilerek doğrulanır.
    function myOrg() {
      return get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.org;
    }

    // ── Müşteri (kurum) profilleri ──
    // Belge kimliği = auth uid. Herkes yalnızca kendi profilini yazar;
    // admin tümünü okur (Müşteriler tablosu için).
    match /customers/{uid} {
      // Profilde yalnızca bu alanlar bulunabilir — ileride eklenecek bir
      // yetki alanının (ör. role) istemciden yazılmasını baştan engeller.
      function validProfile() {
        return request.resource.data.keys().hasOnly(
                 ['org', 'contact', 'phone', 'email', 'ownerUid', 'createdAt']
               ) &&
               request.resource.data.ownerUid == uid &&
               request.resource.data.org is string &&
               request.resource.data.org.size() > 0;
      }

      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid && validProfile());
      allow delete: if false;
    }

    // ── Talepler ──
    // Müşteri kendi taleplerini oluşturur/okur; durum-atama-geri bildirim
    // ve soft-delete (çöp kutusu) güncellemelerini yalnızca admin yapar.
    // Kalıcı silme (delete) HERKESE kapalıdır — veri asla kaybolmaz.
    match /requests/{id} {
      // Müşteri yeni talebi yalnızca "temiz" durumda oluşturabilir:
      // durumu, atamasını, geri bildirimini veya kurum adını kendi seçemez.
      function validNewRequest() {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'code', 'title', 'description', 'note', 'org', 'ownerUid',
                 'status', 'assignee', 'feedback', 'createdAt', 'updatedAt',
                 'history'
               ]) &&
               d.ownerUid == request.auth.uid &&
               d.org == myOrg() &&
               d.status == 'Yeni' &&
               d.assignee == '—' &&
               d.feedback == '' &&
               d.code is string && d.code.matches('#PAX-[0-9]+') &&
               d.title is string && d.title.size() > 0 && d.title.size() <= 200 &&
               d.description is string && d.description.size() <= 5000 &&
               d.note is string && d.note.size() <= 2000 &&
               // Belge içindeki geçmiş yalnızca oluşturma kaydını taşır.
               d.history.size() == 1;
      }

      // Admin güncellemesinde de kimlik alanları değişmez kalır. Belge içi
      // geçmiş dizisi de dondurulmuştur — yeni olaylar alt koleksiyona gider.
      function immutableFields() {
        return request.resource.data.code == resource.data.code &&
               request.resource.data.ownerUid == resource.data.ownerUid &&
               request.resource.data.org == resource.data.org &&
               request.resource.data.createdAt == resource.data.createdAt &&
               request.resource.data.history == resource.data.history;
      }

      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isSignedIn() && validNewRequest();
      allow update: if isAdmin() && immutableFields();
      allow delete: if false;

      // ── Talep geçmişi (oluşturma sonrası olaylar) ──
      // Belge içi dizi yerine alt koleksiyon: geçmiş 1 MB belge sınırına
      // dayanmadan büyüyebilir. Kayıt yalnızca eklenebilir — hiçbir zaman
      // değiştirilemez veya silinemez: denetim izi.
      match /history/{entryId} {
        allow read: if isAdmin() ||
          (isSignedIn() &&
           get(/databases/$(database)/documents/requests/$(id)).data.ownerUid
             == request.auth.uid);
        // Oluşturma sonrası her olayı yönetici üretir.
        allow create: if isAdmin() &&
          request.resource.data.keys().hasOnly(['event', 'by', 'date', 'at']) &&
          request.resource.data.event is string &&
          request.resource.data.event.size() <= 300;
        allow update, delete: if false;
      }
    }

    // ── Personel ──
    // Organizasyon içi ekip listesi; yalnızca yönetici görür ve düzenler.
    // Listeden çıkarma, geçmiş atamaları (requests.assignee) etkilemez.
    match /staff/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100;
      allow delete: if isAdmin();
    }

    // ── Talep kodu sayacı (#PAX-…) ──
    // Talep gönderiminde transaction ile artırılır; oturumlu herkes erişir.
    // Sayaç yalnızca ileri gidebilir — geri alınıp kod çakışması üretilemez.
    match /counters/requests {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['next']) &&
        request.resource.data.next is int;
      allow update: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['next']) &&
        request.resource.data.next is int &&
        request.resource.data.next > resource.data.next;
      allow delete: if false;
    }
  }
}
